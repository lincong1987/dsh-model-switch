{
  "name": "dsh-model-switch",
  "version": "0.6.0",
  "description": "DSH plugin: choose models for subagents and plan execution separately / 为子代理和计划执行选择更合适的模型",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "lincong",
    "url": "https://github.com/lincong1987"
  },
  "homepage": "https://github.com/lincong1987/dsh-model-switch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lincong1987/dsh-model-switch.git"
  },
  "bugs": {
    "url": "https://github.com/lincong1987/dsh-model-switch/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "plan-mode",
    "model-switch"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-user-questions": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-user-questions": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-user-questions": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-gateway": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-client-ui-user-questions": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-subagent": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-user-questions": "0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "unrun": "^0.3.1",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/dsh-typert-protocol@<0.1.2": "0.1.2-alpha.4"
    }
  }
}
